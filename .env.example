# .env.example
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.

# ── Django ────────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=your-super-secret-key-min-50-characters-change-this
DJANGO_SETTINGS_MODULE=config.settings.production

 
# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DB_NAME=postgres
DB_USER=retano_user
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432
# Options: require | disable | verify-full
# Use 'disable' for local dev, 'require' or 'verify-full' for production
DB_SSLMODE=disable

# ── Redis ─────────────────────────────────────────────────────────────────────
# Used for: Django cache (DB 1), Celery broker (DB 2), Celery result backend
# (DB 3). Only REDIS_URL needs to be set — Celery derives its DB 2 / DB 3
# URLs from this automatically (see config/settings/base.py). Only set
# CELERY_BROKER_URL / CELERY_RESULT_BACKEND explicitly below if Celery needs
# to point at a DIFFERENT Redis instance than the cache.
REDIS_URL=redis://127.0.0.1:6379/1
# CELERY_BROKER_URL=redis://127.0.0.1:6379/2
# CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/3

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ── OTP ───────────────────────────────────────────────────────────────────────
OTP_TTL_SECONDS=120
# Which SMS provider sends OTP codes: kavenegar | sms_ir
OTP_PROVIDER=sms_ir

# ── SMS provider ───────────────────────────────────────────────────────────────
KAVENEGAR_API_KEY=your-kavenegar-api-key
SMSIR_API_KEY=your-sms-ir-api-key
SMSIR_OTP_TEMPLATE_ID=123456
SMSIR_CAMPAIGN_LINE_NUMBER=your-sms-ir-line-number-for-campaign-sends

# Analytics cache: serve snapshots immediately and refresh stale data in Celery.
ANALYTICS_CACHE_TTL_SECONDS=86400
ANALYTICS_REPORT_FRESH_SECONDS=900
DASHBOARD_CACHE_FRESH_SECONDS=900
ANALYTICS_REFRESH_LOCK_SECONDS=300

# ── Supabase Storage (async upload pipeline) ───────────────────────────────────
# Service role key — server-side only, NEVER expose to the React frontend.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_UPLOAD_BUCKET=upload-staging
# Row-chunk size for reading Excel files / COPYing into staging tables.
UPLOAD_CHUNK_SIZE=50000

# ── CORS (production only — comma-separated) ──────────────────────────────────
# Example: https://app.retano360.com,https://panel.retano360.com
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Email (production only) ───────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your@email.com
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=noreply@retano360.com


# ── docker-compose image selection (used by CD workflow, not by Django) ───────
IMAGE_NAME=ghcr.io/retano-org/retano
IMAGE_TAG=latest
